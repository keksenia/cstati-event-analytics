# =========================
# Private data: NEVER COMMIT
# =========================
data/raw_private/
data/interim_private/
data/private/
data/raw/
data/interim/

manual/identity_overrides.csv
manual/*private*.csv
manual/*secret*.csv

# Исходные CSV с персональными данными
*.xlsx
*.xls

# Осторожно: CSV обычно могут содержать PII.
# Разрешаем только manual/*.csv, если это метаданные без персональных данных.
*.csv
!manual/event_metadata.csv
!manual/event_aliases.csv
!manual/attendance_corrections.csv
!data/samples_public/*.csv

